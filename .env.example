# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/booksphere?schema=public"
# Required for signing authentication tokens. Use a long random secret in deployment.
JWT_SECRET="replace-with-a-long-random-secret"
# Optional comma-separated browser origins, e.g. https://app.example.com,http://localhost:3000
CORS_ORIGIN="http://localhost:3000"
PORT=8787

# Private S3-compatible object storage. Never expose these values to the frontend.
S3_BUCKET="booksphere-private"
S3_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="replace-with-storage-access-key"
AWS_SECRET_ACCESS_KEY="replace-with-storage-secret"
# Optional for S3-compatible providers (leave blank for AWS S3).
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
# Optional server-side encryption setting supported by the configured bucket.
S3_SSE=""
