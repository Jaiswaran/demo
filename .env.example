# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/booksphere?schema=public"
# Required for signing authentication tokens. Use a long random secret in deployment.
JWT_SECRET="replace-with-a-long-random-secret"
# Optional comma-separated browser origins, e.g. https://app.example.com,http://localhost:3000
CORS_ORIGIN="http://localhost:3000"
PORT=8787
